# Set default behavior to handle all files as text and normalize to LF
* text=auto eol=lf

# Explicitly set common web files to LF
*.astro text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf

# Denote binary files to prevent corruption during normalization
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
bun.lockb binary
